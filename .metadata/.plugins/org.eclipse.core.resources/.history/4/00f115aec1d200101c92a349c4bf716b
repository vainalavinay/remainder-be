package com.project.remainder.scheduler;

import java.time.LocalDateTime;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.scheduling.TaskScheduler;
import org.springframework.scheduling.support.CronTrigger;
import org.springframework.stereotype.Service;

import com.project.remainder.EmailService;

@Service
public class DynamicTaskScheduler 
{
	@Autowired
	private EmailService emailService;
	
	@Autowired
	private TaskScheduler taskScheduler;
	
	public void scheduleEmail(String toEmail, String subject, String message, LocalDateTime time)
	{
		String cronString = convertToCron(time);
		taskScheduler.schedule(()->emailService.sendEmail(toEmail, subject, message), new CronTrigger(cronString));
		
	}

	private String convertToCron(LocalDateTime time) 
	{
		System.out.print(time);
//		int sec = time.getSecond(); 
		int min = time.getMinute();
		int hour = time.getHour();
		int day = time.getDayOfMonth();
//		int month = time.getMonthValue(); 
//		return String.format("15 0/1 * * * ?", min, hour, day);
		return "15 0/1 * * * ?";

	}
} 
 