package com.project.remainder.controller;

import java.time.LocalDateTime;
import java.time.OffsetDateTime;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.CrossOrigin;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RestController;

import com.project.remainder.entity.RemainderData;
import com.project.remainder.repository.RemainderRepository;
import com.project.remainder.scheduler.DynamicTaskScheduler;

@CrossOrigin(origins = "https://remainder-fe.onrender.com")
@RestController
public class EmailController 
{
	
	@Autowired
	private DynamicTaskScheduler dynamicTaskScheduler;
	
	@Autowired
	private RemainderRepository remainderRepository;
	
	@GetMapping("/")
	public String homePage()
	{
		return "Hello world";
	}

	
//	@CrossOrigin(origins = "http://localhost:3000")
	@PostMapping("/scheduleTask")
	public String taskScheduler(@RequestBody RemainderData data)
	{
		remainderRepository.save(data);
		String toEmail = data.getToEmail();
		String subject = data.getSubject();
		String body = data.getMessage();
//		String timeSubString = "data.getDateTime().toString().substring(0,16)";
//		LocalDateTime dt = LocalDateTime.parse(timeSubString);
		LocalDateTime dt = data.getDateTime();
		System.out.println(dt);
		dynamicTaskScheduler.scheduleEmail(toEmail , subject, body, dt);
		return "Task Scheduled for the email: "+ toEmail;
	}
}
