package com.project.remainder.controller;

import java.time.LocalDateTime;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

import com.project.remainder.EmailService;
import com.project.remainder.scheduler.DynamicTaskScheduler;

@RestController
public class EmailController 
{
	
	@Autowired
	private DynamicTaskScheduler dynamicTaskScheduler;
	
//	@Value("${spring.mail.username}")
//	private String toEmail;
	
	@PostMapping("/sendTask")
	public String sendEmail(@RequestParam String toEmail,
            @RequestParam String subject,
            @RequestParam String body,
            @RequestParam String dateTime)
	{
		LocalDateTime dt = LocalDateTime.parse(dateTime);
		dynamicTaskScheduler.scheduleEmail(toEmail , subject, body, dt);
		return "Task Scheduled";
	}
}
