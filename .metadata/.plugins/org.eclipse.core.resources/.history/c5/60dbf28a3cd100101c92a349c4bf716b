package com.project.remainder.repository;

import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.query.Param;
import org.springframework.stereotype.Repository;

@Repository
public interface CartItemRepository extends JpaRepository<CartItem, Integer> 
{
	@Query("DELETE from cartItem where cartItem.cartId = :cartId and cartItem.product.productId = :productId")
	void removeProductsFromCart(@Param("cartId") Integer cartId, @Param("productId") Integer productId);
	
	@Query("DELETE * from cartItem where cartItem.cartItemId = :cartId")
	void removeAllProducts(@Param("cartId") Integer cartId);
}
