package com.project.remainder.controller;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RestController;

import com.project.remainder.EmailService;
import com.project.remainder.scheduler.DynamicTaskScheduler;

@RestController
public class EmailController 
{
	
	@Autowired
	private EmailService emailService;
	
	@Autowired
	private DynamicTaskScheduler dynamicTaskScheduler;
	
	@Value("${spring.mail.username}")
	private String toEmail;
	
	@GetMapping("/sendEmail")
	public String sendEmail()
	{
		dynamicTaskScheduler.scheduleEmail(toEmail, "This is subject", "This is message", "23456");
		return "Task Scheduled";
//		emailService.sendEmail(toEmail, "Subject field", "This is message");
//		return "Email Sent Successfully";
	}
}
